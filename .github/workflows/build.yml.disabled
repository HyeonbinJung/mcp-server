name: build

on:
  push:
    branches: [main]
  pull_request:
  workflow_dispatch:

env:
  REGISTRY: junhyung.cloud
  # Charts must not share a repository with the image: the same tag overwrites the other.
  CHART_REPO: oci://junhyung.cloud/mc-agents/charts
  CHART_REPO_HOST: junhyung.cloud/mc-agents/charts
  IMAGE: junhyung.cloud/mc-agents/mcp-server

jobs:
  check:
    runs-on: ubuntu-latest
    outputs:
      # Whether anything the image or the chart is built from changed. A docs-only push leaves
      # both alone, so :<version> keeps pointing at the build that was tested with it.
      shipped: ${{ steps.version.outputs.shipped }}
    steps:
      - uses: actions/checkout@v7
        with:
          # The version check diffs against the commit this one replaced, which a shallow
          # clone does not have.
          fetch-depth: 0
      - uses: actions/setup-java@v6
        with:
          distribution: temurin
          java-version: 25
      - uses: gradle/actions/setup-gradle@v5

      # A force push leaves nothing to compare against: the commit it names is gone from the
      # repository, and the first push to a branch names the all-zero sha. Only the shape check
      # runs in either case, and the push publishes.
      - name: version is consistent and was raised
        id: version
        env:
          FORCED: ${{ github.event.forced }}
          BASE: ${{ github.event_name == 'pull_request' && github.event.pull_request.base.sha || github.event.before }}
          EMPTY_SHA: '0000000000000000000000000000000000000000'
        run: |
          if [ "$FORCED" = true ] || [ -z "$BASE" ] || [ "$BASE" = "$EMPTY_SHA" ]; then
            ./hack/check-version.sh
          else
            ./hack/check-version.sh "$BASE"
          fi

      - run: ./gradlew build

      # Gradle's summary names the test and nothing else; the report has the assertion and the
      # stack. The e2e job below already keeps its own.
      - uses: actions/upload-artifact@v7
        if: failure()
        with:
          name: unit-tests
          path: build/reports/tests/test

      - name: chart renders
        run: |
          # The chart refuses to render without a token rather than invent one, so hand it one.
          helm lint charts/mc-agents-mcp-server --set auth.token=ci
          helm template charts/mc-agents-mcp-server --set auth.token=ci > /dev/null

      # What this proves is that every tool in the catalogue reaches something that answers. The
      # fake bot never touches Minecraft, so no server is needed and the world is never the
      # reason a tool fails; a tool that says "not wired up yet", one the sweep has no sample
      # for, or one that errors outside the sweep's named set fails the job. So does the join:
      # call.sh exits on a tool error, and without that every tool erred with "not in a world"
      # and the job was green.
      - name: every tool answers
        run: |
          BOT_LINK_PORT=18765 MCP_PORT=13000 ./gradlew bootRun &
          for _ in $(seq 1 60); do
            curl -sf http://127.0.0.1:13000/actuator/health/liveness > /dev/null && break
            sleep 2
          done
          # fabric, because it is the kind every tool is offered to; a fake bot of any other kind
          # offers only part of the catalogue and the sweep would call the rest into a refusal.
          python3 dev/bot.py 18765 ci fabric &
          sleep 3
          ./dev/call.sh join-server '{"bot":"ci","host":"127.0.0.1","port":25565}'
          python3 dev/sweep.py

  # What an agent gets, against a real server and a real bot, asserted on the sentence. The check
  # above proves every tool reaches something that answers; this one proves what it answers. Every
  # case in it is a bug that was once shipped, and until now the things that found them were
  # scripts somebody had to run and read.
  #
  # It drives the published bot image, so a change that needs both sides fails here until the bot
  # is published. That is the coupling the shared catalogue already has, made visible, and publish
  # waits on every shard: a red one blocks the tags, the chart and the release rather than
  # shipping beside them.
  e2e:
    name: e2e (${{ matrix.kind }} ${{ matrix.shard }}/${{ matrix.shards }})
    needs: check
    runs-on: ubuntu-latest
    strategy:
      fail-fast: false
      matrix:
        # Every kind of bot, held to the same sentences. A case whose tools a kind does not run is
        # skipped for that kind, so a tool that gains a kind is tested on it without editing this.
        #
        # A fabric bot spends five seconds on a case an azalea bot answers in one or two, and took a
        # quarter of an hour over all of them, so its cases are shared out between shards that each
        # start a server and a bot of their own. Azalea's one job still finishes before the fabric
        # shards do, so a second shard of it would only pay for another start.
        #
        # Each kind against the Minecraft version it is built for, which is no longer one version:
        # azalea has no release past 26.1.2, and a 26.1.2 client cannot join a 26.3 server. Moving a
        # kind to another is a release of its own.
        include:
          - { kind: fabric, minecraft: "26.3", shard: 1, shards: 4 }
          - { kind: fabric, minecraft: "26.3", shard: 2, shards: 4 }
          - { kind: fabric, minecraft: "26.3", shard: 3, shards: 4 }
          - { kind: fabric, minecraft: "26.3", shard: 4, shards: 4 }
          - { kind: azalea, minecraft: "26.1.2", shard: 1, shards: 1 }
    env:
      MINECRAFT: ${{ matrix.minecraft }}
    steps:
      - uses: actions/checkout@v7
      - uses: actions/setup-java@v6
        with:
          distribution: temurin
          java-version: "25"
      - uses: gradle/actions/setup-gradle@v5

      # The Paper server, ryuk and Testcontainers' sshd come from Docker Hub, and five shards on a
      # shared runner pool meet its anonymous pull limit. In CI they come through the registry's
      # private proxy cache instead, which needs this login. A pull request Dependabot opens runs
      # without the repository's secrets, which is why the login was dropped once; it comes back for
      # the proxy, and Dependabot pull requests get the same two names as Dependabot secrets, set by
      # the owner. The bot images are on the public mc-agents project and need no login.
      - uses: docker/login-action@v4
        with:
          registry: ${{ env.REGISTRY }}
          username: ${{ secrets.REGISTRY_USERNAME }}
          password: ${{ secrets.REGISTRY_PASSWORD }}

      - name: what an agent gets
        env:
          BOT_IMAGE: junhyung.cloud/mc-agents/bot-${{ matrix.kind }}:latest-mc${{ env.MINECRAFT }}
          # Both prefixes are empty by default so a laptop pulls from Docker Hub without a login:
          # this one is read by the suite for the Paper image, the Testcontainers one covers sshd,
          # which the suite never names.
          E2E_HUB_PREFIX: ${{ env.REGISTRY }}/docker-hub/
          TESTCONTAINERS_HUB_IMAGE_NAME_PREFIX: ${{ env.REGISTRY }}/docker-hub/
          # Ryuk is a container that kills the run's other containers when the JVM that asked for
          # them goes away. A runner is thrown away after the job, so there is nothing for it to
          # clean up -- and pulling it was the single most common way this job failed, three times
          # in one afternoon, always before a test had run. It is the registry's proxy reaching
          # Docker Hub that is flaky, and the fix that needs no registry is not to need the image.
          TESTCONTAINERS_RYUK_DISABLED: "true"
        run: |
          # The bot is the slowest pull of the run, nearly two minutes for fabric, and the suite asks
          # for it only once its server is up. Started here it downloads while Gradle and the server
          # start, and the suite's own pull waits on this one rather than beginning again.
          docker pull --quiet "$BOT_IMAGE" > /dev/null &

          # Twice, and the second time from nothing. What starves a case here is the runner and not
          # the case: a Modrinth that answered nothing took all five shards out at once, and two
          # different cases have failed on a fixed wait that a loaded runner outran. Retrying a case
          # inside the run was tried and is not this, deliberately -- a case that summons something
          # and clears it at the end summons it twice, and the second run passes with its premise
          # broken. Throwing the containers away and starting the shard again cannot do that, since
          # a fresh server is a fresh world.
          #
          # --rerun-tasks because Gradle would otherwise call a failed task up to date, and a
          # warning rather than silence because a shard that only passes on the second go is a
          # thing to notice rather than a green tick.
          rerun=""
          for attempt in 1 2; do
            if ./gradlew :e2e:test $rerun \
              -Pe2e.minecraft.version=$MINECRAFT \
              -Pe2e.bot.kind=${{ matrix.kind }} \
              -Pe2e.bot.image=$BOT_IMAGE \
              -Pe2e.shard=${{ matrix.shard }}/${{ matrix.shards }}; then
              exit 0
            fi
            echo "::warning title=e2e shard retried::${{ matrix.kind }} ${{ matrix.shard }}/${{ matrix.shards }} failed on attempt ${attempt} of 2"
            rerun="--rerun-tasks"
          done
          exit 1

      - uses: actions/upload-artifact@v7
        if: failure()
        with:
          name: e2e-${{ matrix.kind }}-${{ matrix.shard }}of${{ matrix.shards }}-${{ env.MINECRAFT }}
          path: e2e/build/reports/tests/test

  # The tag both publish jobs use. Computed once so two runners cannot disagree about the stamp.
  # A push that changed nothing the image or the chart is built from publishes nothing: the
  # version stays on the build it was tested with, and the stamp is the only tag that would differ.
  tag:
    needs: check
    if: github.event_name != 'pull_request' && needs.check.outputs.shipped != 'false'
    runs-on: ubuntu-latest
    outputs:
      value: ${{ steps.tag.outputs.value }}
      version: ${{ steps.tag.outputs.version }}
    steps:
      - uses: actions/checkout@v7
      - id: tag
        run: |
          version=$(tr -d '[:space:]' < VERSION)
          stamp=$(date -u +%Y%m%d%H%M%S)
          sha=$(git rev-parse --short=8 HEAD)
          case "$version" in *-*) sep=. ;; *) sep=- ;; esac
          echo "value=${version}${sep}${stamp}.g${sha}" >> "$GITHUB_OUTPUT"
          # The chart's appVersion falls back to this one, so it has to exist in the registry.
          echo "version=${version}" >> "$GITHUB_OUTPUT"

  # Paketo builds one architecture per invocation, and cross-building runs the whole builder under
  # emulation. A native runner each is both faster and simpler; the manifest list joins them after.
  image:
    needs: tag
    strategy:
      matrix:
        include:
          - runner: ubuntu-latest
            arch: amd64
          - runner: ubuntu-24.04-arm
            arch: arm64
    runs-on: ${{ matrix.runner }}
    permissions:
      contents: read
    steps:
      - uses: actions/checkout@v7
      - uses: actions/setup-java@v6
        with:
          distribution: temurin
          java-version: 25
      - uses: gradle/actions/setup-gradle@v5
      - uses: docker/login-action@v4
        with:
          registry: ${{ env.REGISTRY }}
          username: ${{ secrets.REGISTRY_USERNAME }}
          password: ${{ secrets.REGISTRY_PASSWORD }}

      - name: build and push
        env:
          TAG: ${{ needs.tag.outputs.value }}-${{ matrix.arch }}
          REGISTRY_USERNAME: ${{ secrets.REGISTRY_USERNAME }}
          REGISTRY_PASSWORD: ${{ secrets.REGISTRY_PASSWORD }}
        run: ./gradlew bootBuildImage --publishImage --imageName "$IMAGE:$TAG"

  # Nothing is published unless every shard is green. There is no branch ruleset: a push to main
  # stays allowed, and this gate is what stands between a red suite and a release.
  publish:
    needs: [tag, image, e2e]
    runs-on: ubuntu-latest
    permissions:
      # write for the git tag and the release, and in this job alone.
      contents: write
      # Lets cosign fetch a short-lived certificate from Fulcio, so no key lives in the repo.
      id-token: write
    steps:
      - uses: actions/checkout@v7
        with:
          # The release notes are the commits since the previous tag, and a shallow clone has
          # neither the tags nor the commits.
          fetch-depth: 0
      - uses: docker/setup-buildx-action@v3
      - uses: docker/login-action@v4
        with:
          registry: ${{ env.REGISTRY }}
          username: ${{ secrets.REGISTRY_USERNAME }}
          password: ${{ secrets.REGISTRY_PASSWORD }}
      - uses: sigstore/cosign-installer@v3

      - id: manifest
        env:
          TAG: ${{ needs.tag.outputs.value }}
          VERSION: ${{ needs.tag.outputs.version }}
        run: |
          for name in "$TAG" "$VERSION" latest; do
            docker buildx imagetools create --tag "$IMAGE:$name" \
              "$IMAGE:$TAG-amd64" "$IMAGE:$TAG-arm64"
          done
          digest=$(docker buildx imagetools inspect "$IMAGE:$TAG" --format '{{.Manifest.Digest}}')
          echo "digest=$digest" >> "$GITHUB_OUTPUT"

      - name: sign image
        run: cosign sign --yes "${{ env.IMAGE }}@${{ steps.manifest.outputs.digest }}"

      # Under the release version and pointing at it, so installing the chart at a version installs
      # the server of that version. The chart used to say 0.8.0 while the server was forty releases
      # past it, and nothing published it, so an install from the repository ran a server that old.
      - name: push chart
        env:
          VERSION: ${{ needs.tag.outputs.version }}
          REGISTRY_USERNAME: ${{ secrets.REGISTRY_USERNAME }}
          REGISTRY_PASSWORD: ${{ secrets.REGISTRY_PASSWORD }}
        run: |
          helm package charts/mc-agents-mcp-server --version "$VERSION" --app-version "$VERSION" --destination dist-chart
          printf '%s' "$REGISTRY_PASSWORD" \
            | helm registry login "$REGISTRY" --username "$REGISTRY_USERNAME" --password-stdin
          helm push "dist-chart/mc-agents-mcp-server-$VERSION.tgz" "$CHART_REPO" 2>&1 | tee push.log
          digest=$(grep -o 'sha256:[0-9a-f]\{64\}' push.log | head -1)
          test -n "$digest"
          cosign sign --yes "$CHART_REPO_HOST/mc-agents-mcp-server@$digest"

      # The image tags map the version to a build; this maps it to a commit, which is what a
      # bisect or a diff between two releases needs. A tag that is already there is left where it
      # is: a re-run of this job must not say a different commit shipped the version.
      #
      # The notes are the commits since the previous tag plus the catalogue version and the bot
      # tags the suite ran against. GitHub's generated notes list pull requests, and a repository
      # pushed to directly has none to list.
      - name: tag and release
        env:
          VERSION: ${{ needs.tag.outputs.version }}
          GH_TOKEN: ${{ github.token }}
        run: |
          if ! git ls-remote --exit-code --tags origin "refs/tags/v$VERSION" > /dev/null; then
            git tag "v$VERSION" "$GITHUB_SHA"
            git push origin "v$VERSION"
          fi
          if ! gh release view "v$VERSION" > /dev/null 2>&1; then
            ./hack/release-notes.sh "$VERSION" release-notes.md
            gh release create "v$VERSION" --title "v$VERSION" --notes-file release-notes.md
          fi

      - env:
          TAG: ${{ needs.tag.outputs.value }}
        run: |
          {
            echo "published \`$IMAGE:$TAG\`"
            echo ""
            echo "verify:"
            echo '```'
            echo "cosign verify $IMAGE:$TAG \\"
            echo "  --certificate-identity-regexp '^https://github.com/${{ github.repository }}/' \\"
            echo "  --certificate-oidc-issuer https://token.actions.githubusercontent.com"
            echo '```'
          } >> "$GITHUB_STEP_SUMMARY"
